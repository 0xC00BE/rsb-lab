        "svgcontent": "<svg width=\"1600\" height=\"900\" xmlns=\"http://www.w3.org/2000/svg\"><g><title>Layer 1</title><rect width=\"1600\" height=\"900\" fill=\"#0f172a\"/><rect x=\"0\" y=\"0\" width=\"1600\" height=\"116\" fill=\"#be123c\"/><text x=\"48\" y=\"52\" font-family=\"Arial\" font-size=\"34\" font-weight=\"700\" fill=\"#ffffff\">Packaging</text><text x=\"50\" y=\"86\" font-family=\"Arial\" font-size=\"16\" fill=\"#ffffff\">PLC Packaging Â· 18 live tags</text><text x=\"1518\" y=\"52\" font-family=\"Arial\" font-size=\"15\" text-anchor=\"end\" fill=\"#e2e8f0\">RSB VIRTUAL BREWERY</text><text x=\"1518\" y=\"78\" font-family=\"Arial\" font-size=\"12\" text-anchor=\"end\" fill=\"#cbd5e1\">LIVE Â· READ-ONLY OPERATIONS</text><rect x=\"50\" y=\"170\" width=\"360\" height=\"54\" rx=\"8\" fill=\"#f8fafc\" stroke=\"#cbd5e1\"/><text x=\"62\" y=\"190\" font-family=\"Arial\" font-size=\"13\" fill=\"#475569\">Filter DP</text><g data-name=\"value_1\" type=\"svg-ext-value\" id=\"VAL_8A5415FA33BA51CE\" text-anchor=\"end\" font-family=\"Arial\" font-size=\"20\" font-weight=\"700\" fill=\"#be123c\" stroke-width=\"0\"><text x=\"398\" y=\"213\" id=\"TXT_ED0EEDFEF9D60944\">##.##</text></g><rect x=\"432\" y=\"170\" width=\"360\" height=\"54\" rx=\"8\" fill=\"#f8fafc\" stroke=\"#cbd5e1\"/><text x=\"444\" y=\"190\" font-family=\"Arial\" font-size=\"13\" fill=\"#475569\">Flow L/min</text><g data-name=\"value_2\" type=\"svg-ext-value\" id=\"VAL_02356562CAAD79AC\" text-anchor=\"end\" font-family=\"Arial\" font-size=\"20\" font-weight=\"700\" fill=\"#be123c\" stroke-width=\"0\"><text x=\"780\" y=\"213\" id=\"TXT_355D996171C21C94\">##.##</text></g><rect x=\"814\" y=\"170\" width=\"360\" height=\"54\" rx=\"8\" fill=\"#f8fafc\" stroke=\"#cbd5e1\"/><text x=\"826\" y=\"190\" font-family=\"Arial\" font-size=\"13\" fill=\"#475569\">Source Level Pct</text><g data-name=\"value_3\" type=\"svg-ext-value\" id=\"VAL_F6AE947E6F0BD0B0\" text-anchor=\"end\" font-family=\"Arial\" font-size=\"20\" fo