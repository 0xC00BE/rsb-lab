        "svgcontent": "<svg width=\"1600\" height=\"900\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:svg=\"http://www.w3.org/2000/svg\">\n <g>\n  <title>Layer 1</title>\n  <rect width=\"1600\" height=\"900\" fill=\"#0f172a\" id=\"svg_aba63732-77484431\"/>\n  <rect x=\"0\" y=\"0\" width=\"1600\" height=\"116\" fill=\"#2563eb\" id=\"svg_fe939d2e-31954653\"/>\n  <text x=\"48\" y=\"52\" font-family=\"Arial\" font-size=\"34\" font-weight=\"700\" fill=\"#ffffff\" id=\"svg_4a0ad326-31274029\">RSB Plant Overview</text>\n  <text x=\"50\" y=\"86\" font-family=\"Arial\" font-size=\"16\" fill=\"#ffffff\" id=\"svg_4fe80e2d-0dce49f0\">Six-cell process health, connectivity and principal measurements</text>\n  <text x=\"1518\" y=\"52\" font-family=\"Arial\" font-size=\"15\" text-anchor=\"end\" fill=\"#e2e8f0\" id=\"svg_98cad8c1-12444c3e\">RSB VIRTUAL BREWERY</text>\n  <text x=\"1518\" y=\"78\" font-family=\"Arial\" font-size=\"12\" text-anchor=\"end\" fill=\"#cbd5e1\" id=\"svg_06e1f75f-602b4b02\">LIVE Â· READ-ONLY OPERATIONS</text>\n  <rect x=\"50\" y=\"170\" width=\"360\" height=\"54\" rx=\"8\" fill=\"#f8fafc\" stroke=\"#cbd5e1\" id=\"svg_5f592925-b5f8457c\"/>\n  <text x=\"62\" y=\"190\" font-family=\"Arial\" font-size=\"13\" fill=\"#475569\" id=\"svg_fc5d5fb1-f9d340d1\">Plc Raw Materials Connection Status</text>\n  <g data-name=\"value_1\" type=\"svg-ext-value\" id=\"VAL_ADD72E7613FAEA73\" text-anchor=\"end\" font-family=\"Arial\" font-size=\"20\" font-weight=\"700\" fill=\"#2563eb\" stroke-width=\"0\">\n   <text x=\"398\" y=\"213\" id=\"TXT_851DDF20C86DFBCE\">##.##</text>\n  </g>\n  <rect x=\"432\" y=\"170\" width=\"360\" height=\"54\" rx=\"8\" fill=\"#f8fafc\" stroke=\"#cbd5e1\" id=\"svg_68f0c818-f3714d27\"/>\n  <text x=\"444\" y=\"190\" font-family=\"Arial\" font-size=\"13\" fill=\"#475569\" id=\"svg_ac4e61bb-2bbc47b6\">Plc Brewhouse Connection Status</text>\n  <g data-name=\"value_2\" type=\"svg-ext-value\" id=\"VAL_09A89828C5EEFFC4\" text-anchor=\"end\" font-family=\"Arial\"