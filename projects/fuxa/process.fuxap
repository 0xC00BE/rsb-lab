        "variables": {},
        "svgcontent": "<svg width=\"1600\" height=\"900\" xmlns=\"http://www.w3.org/2000/svg\"><g><title>Layer 1</title><rect width=\"1600\" height=\"900\" fill=\"#0b1220\"/><rect width=\"1600\" height=\"112\" fill=\"#2563eb\"/><text x=\"46\" y=\"50\" font-family=\"Arial\" font-size=\"34\" font-weight=\"700\" fill=\"#fff\">RSB Brewery Process Overview</text><text x=\"48\" y=\"84\" font-family=\"Arial\" font-size=\"16\" fill=\"#e2e8f0\">Raw materials â†’ brewhouse â†’ fermentation â†’ conditioning â†’ packaging</text><text x=\"1548\" y=\"48\" text-anchor=\"end\" font-family=\"Arial\" font-size=\"14\" fill=\"#e2e8f0\">RSB VIRTUAL BREWERY</text><text x=\"1548\" y=\"75\" text-anchor=\"end\" font-family=\"Arial\" font-size=\"12\" fill=\"#cbd5e1\">LIVE Â· READ-ONLY PROCESS VIEW</text><rect x=\"70\" y=\"250\" width=\"190\" height=\"270\" rx=\"18\" fill=\"#17243a\" stroke=\"#2563eb\" stroke-width=\"3\"/><text x=\"165.0\" y=\"292\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"19\" font-weight=\"700\" fill=\"#f8fafc\">Raw materials</text><path d=\"M100 350 L230 350 L230 460 L100 460 Z\" fill=\"#1e3a52\" stroke=\"#64748b\"/><path d=\"M242 385 L280 385\" stroke=\"#38bdf8\" stroke-width=\"6\" stroke-dasharray=\"12 10\"/><rect x=\"88\" y=\"480\" width=\"154\" height=\"54\" rx=\"8\" fill=\"#f8fafc\" stroke=\"#cbd5e1\"/><text x=\"100\" y=\"500\" font-family=\"Arial\" font-size=\"13\" fill=\"#475569\">Silo1 Kg</text><g data-name=\"value_1\" type=\"svg-ext-value\" id=\"VAL_A08885B945953CBC\" text-anchor=\"end\" font-family=\"Arial\" font-size=\"20\" font-weight=\"700\" fill=\"#2563eb\" stroke-width=\"0\"><text x=\"230\" y=\"523\" id=\"TXT_800FD6867D5A930D\">##.##</text></g><rect x=\"330\" y=\"250\" width=\"190\" height=\"270\" rx=\"18\" fill=\"#17243a\" stroke=\"#2563eb\" stroke-width=\"3\"/><text x=\"425.0\" y=\"292\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"19\" font-weight=\"700\" fill=\"#f8fafc\">Brewhouse</text><path d=\"M360 350 L490 350 L490 460 L360 460 Z\" fill=\"#1e3a52\" stroke=\"#64748b\"/><path d=\"M502 385 L540 385\" stroke=\"#38bdf8\" stroke-width=\"6\" stroke-dasharray=\"12 10\"/><rect x=\"348\" y=\"480\" width=\"154\" height=\"54\" rx=\"8\" fill=\"#f8fafc\" stroke=\"#cbd5e1\"/><text x=\"360\" y=\"500\" font-family=\"Arial\" font-size=\"13\" fill=\"#475569\">Mash Tun Temp</text><g data-name=\"value_2\" type=\"svg-ext-value\" id=\"VAL_76D518000D35CD2D\" text-anchor=\"end\" font-family=\"Arial\" font-size=\"20\" font-weight=\"700\" fill=\"#2563eb\" stroke-width=\"0\"><text x=\"490\" y=\"523\" id=\"TXT_9B611C8C43CCA8E9\">##.##</text></g><rect x=\"590\" y=\"250\" width=\"190\" height=\"270\" rx=\"18\" fill=\"#17243a\" stroke=\"#2563eb\" stroke-width=\"3\"/><text x=\"685.0\" y=\"292\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"19\" font-weight=\"700\" fill=\"#f8fafc\">Fermentation</text><path d=\"M620 350 L750 350 L750 460 L620 460 Z\" fill=\"#1e3a52\" stroke=\"#64748b\"/><path d=\"M762 385 L800 385\" stroke=\"#38bdf8\" stroke-width=\"6\" stroke-dasharray=\"12 10\"/><rect x=\"608\" y=\"480\" width=\"154\" height=\"54\" rx=\"8\" fill=\"#f8fafc\" stroke=\"#cbd5e1\"/><text x=\"620\" y=\"500\" font-family=\"Arial\" font-size=\"13\" fill=\"#475569\">T1 Temp C</text><g data-name=\"value_3\" type=\"svg-ext-value\" id=\"VAL_EC6199EB0A15EA3C\" text-anchor=\"end\" font-family=\"Arial\" font-size=\"20\" font-weight=\"700\" fill=\"#2563eb\" stroke-width=\"0\"><text x=\"750\" y=\"523\" id=\"TXT_F47A545C8E6572CC\">##.##</text></g><rect x=\"850\" y=\"250\" width=\"190\" height=\"270\" rx=\"18\" fill=\"#17243a\" stroke=\"#2563eb\" stroke-width=\"3\"/><text x=\"945.0\" y=\"292\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"19\" font-weight=\"700\" fill=\"#f8fafc\">Conditioning</text><path d=\"M880 350 L1010 350 L1010 460 L880 460 Z\" fill=\"#1e3a52\" stroke=\"#64748b\"/><path d=\"M1022 385 L1060 385\" stroke=\"#38bdf8\" stroke-width=\"6\" stroke-dasharray=\"12 10\"/><rect x=\"868\" y=\"480\" width