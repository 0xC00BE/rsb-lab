    "z": "tab-rawmat",
    "name": "Map to tags",
    "func": "const r = msg.payload;\nreturn [{\n  measurement: 'raw_materials',\n  payload: {\n        LT101_silo1_kg:    r[0],\n        LT102_silo2_kg:    r[1],\n        ST101_mill_rpm:    r[2],\n        ZT101_auger_A:     r[3],\n        TT201_hlt_temp:    r[4] / 10.0,\n        LT201_hlt_level:   r[5],\n        FT201_hlt_flow:    r[6],\n        TT202_clt_temp:    r[7] / 10.0,\n        LT202_clt_level:   r[8]\n      }\n}];",
    "outputs": 1,
    "x": 540,
    "y": 80,
    "wires": [
      [
        "write-rawmat"
      ]
    ]
  },
